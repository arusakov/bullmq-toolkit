{
  "name": "bullmq-toolkit",
  "version": "",
  "description": "Helper classes for efficient management of multiple BullMQ queues & workers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arusakov/bullmq-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/arusakov/bullmq-toolkit/issues"
  },
  "author": "Aleksandr Rusakov <aleksandr.s.rusakov@gmail.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bullmq": "^6.3.15",
    "c8": "^12.0.0",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "bullmq": "^6.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p . --rootDir src --outDir dist",
    "compile": "tsc --noEmit -p .",
    "compile:test": "tsc --noEmit -p test",
    "test:all": "npm run test -- ./test/**/*.test.ts",
    "test:coverage": "c8 --reporter=lcovonly --reporter=text npm run test:all",
    "test": "node --test --test-concurrency=1"
  }
}
